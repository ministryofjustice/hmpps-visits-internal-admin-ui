{%- from "govuk/components/tag/macro.njk" import govukTag -%}

{% macro prisonClientTags(prison) -%}
  {%- set staffPrisonUserClient = prison.staffPrisonUserClient -%}
  {%- set publicPrisonUserClient = prison.publicPrisonUserClient -%}

  {%- set activeClients = []
    .concat([staffPrisonUserClient] if staffPrisonUserClient.active else [])
    .concat([publicPrisonUserClient] if publicPrisonUserClient and publicPrisonUserClient.active else [])
  -%}

  {{- govukTag({ text: "None", classes: "govuk-tag--grey" }) if not activeClients | length -}}

  {%- for client in activeClients %}
  {{- govukTag({
    text: client.userType | capitalize,
    classes:
      ("govuk-!-margin-left-2 " if not loop.first) +
      ("govuk-tag--green" if client.userType == "STAFF" else "govuk-tag--purple")
  }) if client.active -}}
  {%- endfor %}
{%- endmacro %}
