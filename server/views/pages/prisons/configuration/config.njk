{% extends "partials/layout.njk" %}
{%- from "govuk/components/button/macro.njk" import govukButton -%}
{%- from "govuk/components/tag/macro.njk" import govukTag -%}
{% from "components/subNavigation.njk" import subNavigation %}
{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/checkboxes/macro.njk" import govukCheckboxes %}
{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/details/macro.njk" import govukDetails %}

{% set pageHeaderTitle = prison.name %}
{% set pageTitle = applicationName + " - Configuration - " + pageHeaderTitle %}
{% set activePrimaryNav = "prisons" %}

{% set changeStatusAction = "deactivate" if prison.active else "activate" %}

{% block content %}
  {{ super() }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      <h1 class="govuk-heading-l">
        <span>{{ pageHeaderTitle }}</span>
      </h1>

      {% include "partials/prisonStatusAndClients.njk" %}
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
      {{ subNavigation(prison.code, "config") }}
    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h2 class="govuk-heading-m">Booking windows</h2>

      <h3 class="govuk-heading-s">Staff service</h3>
      <p>
        If the minimum window is set to 0 days, visits can be booked on the same day.
        If the booking window is set to 1 day, visits can be booked the next day.
      </p>

      <h3 class="govuk-heading-s">Public service</h3>
      <p>
        The public service uses complete working days (Monday to Friday excluding Bank Holidays).
      </p>
      {% call govukDetails({
        summaryText: "Public service booking window example"
      }) %}
        For example, if the public booking window is set to 2 days and a booker attempts
        to book a visit on a Thursday, the soonest available working day will be the Tuesday of
        the next week. This is the earliest available next working day as Friday
        (1st complete working day), Saturday, Sunday (non-working days) and Monday
        (2nd complete working day) are skipped.
      {% endcall %}

      {# Build prison client rows for booking windows #}
      {% set prisonClients =
        [prison.staffPrisonUserClient]
        .concat([prison.publicPrisonUserClient] if prison.publicPrisonUserClient else [])
      %}
      {% set prisonClientRows = [] %}
      {% for client in prisonClients %}
        {% set serviceType = client.clientType | lower %}
        {% set prisonClientRows = (prisonClientRows.push([
          {
            html: govukTag({
              text: client.clientType,
              classes: "govuk-tag--green" if client.clientType == "STAFF" else "govuk-tag--purple"
            }) +
            (" (not enabled)" if not client.active),
            classes: "nowrap",
            attributes: { "data-test": "service-type-" + serviceType }
          },
          {
            text: client.policyNoticeDaysMin + (" day" | pluralise(client.policyNoticeDaysMin)),
            attributes: { "data-test": "min-days-" + serviceType }
          },
          {
            text: client.policyNoticeDaysMax + (" day" | pluralise(client.policyNoticeDaysMax)),
            attributes: { "data-test": "max-days-" + serviceType }
          }
        ]), prisonClientRows) %}
      {% endfor %}

      {{ govukTable({
        head: [
          {
            text: "Service"
          },
          {
            text: "Minimum window"
          },
          {
            text: "Maximum window"
          }
        ],
        rows: prisonClientRows
      }) }}

      {{ govukButton({
        text: "Edit booking windows",
        classes: "govuk-!-margin-0",
        href: "/prisons/" + prison.code + "/configuration/booking-windows/edit",
        preventDoubleClick: true,
        attributes: { "data-test": "booking-windows-edit" }
      })}}

      <hr class="govuk-section-break govuk-section-break--xl">
      <h2 class="govuk-heading-m">Contact details</h2>

      {% if prisonContactDetails %}
        {{ govukSummaryList({
          rows: [
            {
              key: {
                text: "Social visits email"
              },
              value: {
                text: prisonContactDetails.emailAddress if prisonContactDetails.emailAddress else "Not set",
                classes: "test-contact-email"
              }
            },
            {
              key: {
                text: "Social visits telephone"
              },
              value: {
                text: prisonContactDetails.phoneNumber if prisonContactDetails.phoneNumber else "Not set",
                classes: "test-contact-phone"
              }
            },
            {
              key: {
                text: "Prison web address"
              },
              value: {
                html: '<a class="govuk-link--no-visited-state" href="' + prisonContactDetails.webAddress + '" target="_blank" rel="noopener noreferrer">' + prisonContactDetails.webAddress | escape + "</a>"
                  if prisonContactDetails.webAddress else "Not set",
                  classes: "test-contact-web"
              }
            }
          ]
        }) }}

        {{ govukButton({
          text: "Edit contact details",
          classes: "govuk-!-margin-0",
          href: "/prisons/" + prison.code + "/configuration/contact-details/edit",
          preventDoubleClick: true,
          attributes: { "data-test": "contact-details-edit" }
        })}}

      {% else %}

        <p>No contact details have been entered for this prison.</p>

        {{ govukButton({
          text: "Add contact details",
          classes: "govuk-!-margin-0",
          href: "/prisons/" + prison.code + "/configuration/contact-details/add",
          preventDoubleClick: true,
          attributes: { "data-test": "contact-details-add" }
        })}}
      {% endif %}

      <hr class="govuk-section-break govuk-section-break--xl">
      <h2 class="govuk-heading-m">Enabled services</h2>

      <p>Select which services this prison should have enabled.</p>

      <form action="/prisons/{{ prison.code }}/update-enabled-services" data-test="prison-enabled-services-form" method="POST" novalidate>

        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

        {{ govukCheckboxes({
          name: "enabledServices",
          items: [
            {
              value: "STAFF",
              text: "Staff",
              checked: prison.staffPrisonUserClient.active
            },
            {
              value: "PUBLIC",
              text: "Public",
              checked: prison.publicPrisonUserClient and prison.publicPrisonUserClient.active
            }
          ]
        }) }}

        {{ govukButton({
          text: "Update enabled services",
          classes: "govuk-!-margin-0",
          preventDoubleClick: true,
          attributes: { "data-test": "update-enabled-services" }
        })}}
      </form>

      <hr class="govuk-section-break govuk-section-break--xl">
      <h2 class="govuk-heading-m">Visitor configuration</h2>

      {{ govukSummaryList({
        rows: [
          {
            key: {
              text: "Max total visitors"
            },
            value: {
              text: prison.maxTotalVisitors,
              classes: "test-max-total-visitors"
            }
          },
          {
            key: {
              text: "Max number of adults"
            },
            value: {
              text: prison.maxAdultVisitors,
              classes: "test-max-adult-visitors"
            }
          },
          {
            key: {
              text: "Max number of children"
            },
            value: {
              text: prison.maxChildVisitors,
              classes: "test-max-child-visitors"
            }
          },
          {
            key: {
              text: "Adult age threshold"
            },
            value: {
              text: prison.adultAgeYears,
              classes: "test-adult-age"
            }
          }
        ]
      }) }}

      {{ govukButton({
        text: "Edit visitor configuration",
        classes: "govuk-!-margin-0",
        href: "/prisons/" + prison.code + "/configuration/visitors/edit",
        preventDoubleClick: true,
        attributes: { "data-test": "visitor-config-edit" }
      })}}


      <hr class="govuk-section-break govuk-section-break--xl">
      <h2 class="govuk-heading-m">Visit allocation balances</h2>
      <p>There {{ "is" | pluralise(negativeBalanceCount, "are") }}
        <span data-test="negative-balance-count"><strong>{{ negativeBalanceCount }} {{ "prisoner" | pluralise(negativeBalanceCount) }}</strong></span>
        with a negative visit allocation balance. This includes both VOs and PVOs.
      </p>

      {% if negativeBalanceCount > 0 %}
        <p>You can reset any negative balances to zero for all prisoners at this prison.</p>

        {{ govukButton({
          text: "Reset negative balances",
          href: "/prisons/" + prison.code + "/allocations/reset/confirm",
          classes: "govuk-button--warning",
          preventDoubleClick: true,
          attributes: { "data-test": "visit-allocation-reset" }
        })}}
      {% endif %}

      <hr class="govuk-section-break govuk-section-break--xl">
      <h2 class="govuk-heading-m">Prison status</h2>

      <form action="/prisons/{{ prison.code }}/{{ changeStatusAction }}" data-test="prison-change-status-form" method="POST" novalidate>

        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

        {{ govukButton({
          text: changeStatusAction | capitalize,
          classes: "govuk-button--warning" if prison.active,
          preventDoubleClick: true,
          attributes: { "data-test": "prison-change-status" }
        })}}
      </form>

    </div>
  </div>
{% endblock %}
