{% extends "partials/layout.njk" %}
{%- from "govuk/components/button/macro.njk" import govukButton -%}
{%- from "govuk/components/input/macro.njk" import govukInput -%}
{% from "govuk/components/error-message/macro.njk" import govukErrorMessage %}
{%- from "govuk/components/tag/macro.njk" import govukTag -%}
{% from "govuk/components/fieldset/macro.njk" import govukFieldset %}

{% set pageHeaderTitle = action | capitalize + " Edit prison booking windows" %}
{% set pageTitle = applicationName + " - Edit prison booking windows - " + pageHeaderTitle %}
{% set activePrimaryNav = "prisons" %}
{% set backLinkHref = "/prisons/" + prison.code + "/configuration" %}

{% block content %}
  {{ super() }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      <h1 class="govuk-heading-l">
        <span class="govuk-caption-l">{{ prison.name }}</span>
        {{ pageHeaderTitle }}
      </h1>

    </div>
  </div>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-full">

      <form action="/prisons/{{ prison.code }}/configuration/booking-windows/edit" method="POST" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

        {% set prisonClients =
          [prison.staffPrisonUserClient]
          .concat([prison.publicPrisonUserClient] if prison.publicPrisonUserClient else [])
        %}
        {% for client in prisonClients %}
          {% call govukFieldset({
            legend: {
              html:
                "Booking windows: " +
                govukTag({
                  text: client.clientType,
                  classes: "govuk-tag--green" if client.clientType == "STAFF" else "govuk-tag--purple"
                }) +
                (" (not enabled)" if not client.active else ""),
              classes: "govuk-fieldset__legend--m"
            }
          }) %}

            {{ govukInput({
              label: {
                text: "Minimum",
                classes: "govuk-label--s"
              },
              hint: {
                text: "Enter a minimum value in days"
              },
              id: "minDays." + client.clientType,
              name: "minDays[" + client.clientType + "]",
              classes: "govuk-input--width-2",
              value: formValues.minDays[client.clientType],
              autocomplete: "off",
              spellcheck: false,
              errorMessage: errors | findError("minDays." + client.clientType)
            }) }}

            {{ govukInput({
              label: {
                text: "Maximum",
                classes: "govuk-label--s"
              },
              hint: {
                text: "Enter a maximum value in days"
              },
              id: "maxDays." + client.clientType,
              name: "maxDays[" + client.clientType + "]",
              classes: "govuk-input--width-2",
              value: formValues.maxDays[client.clientType],
              autocomplete: "off",
              spellcheck: false,
              errorMessage: errors | findError("maxDays." + client.clientType)
            }) }}

          {% endcall %}
        {% endfor %}

        {{ govukButton({
          text: "Update",
          attributes: { "data-test": "submit" },
          preventDoubleClick: true
        }) }}
      </form>

    </div>
  </div>

{% endblock %}
